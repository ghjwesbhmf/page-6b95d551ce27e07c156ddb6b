4A423E;line-height: 1.7}\n    .bottom-nav {position: fixed;bottom: 0;left: 0;right: 0;height: 52px;background: #251F1D;display: flex;justify-content: center;align-items: center;border-top: 2px solid #9C3321;z-index: 100;padding: 0 16px}\n    .bottom-nav-inner {width: 100%;max-width: 860px;display: flex;justify-content: space-between;align-items: center}\n    .nav-brand {color: #EAE3DC;font-size: 0.88rem;font-weight: 600;letter-spacing: 0.05em}\n    .nav-links {display: flex;gap: 20px}\n    .nav-links a {color: #BCB2AA;font-size: 0.82rem;letter-spacing: 0.02em}\n    .nav-links a:hover {color: #FFFFFF;text-decoration: none}\n    @media (max-width: 600px) {\n      main {padding: 32px 16px 64px 16px}\n      h1 {font-size: 1.75rem}\n      .plan-header {flex-direction: column;align-items: flex-start}\n      .plan-pricing {text-align: left}\n      .nav-links {gap: 12px}\n    }\n  </style><main>\n    <div class=\"hero-timeline\">\n      <div class=\"timeline-node\">\n        <p class=\"timeline-meta\">ARCHIVE // 专线工程与通路演化</p>\n        <h1>大阪国際 · 大阪國際</h1>\n        <p class=\"lead-text\">\n          在国际网络边界不断重塑的语境下，单纯追逐瞬时带宽往往掩盖了链路稳定与路由抖动的本真矛盾。大阪國際将节点拓扑、中继传输与终端调优并置于同一叙事下，以工程师式的严谨规约，阐释长周期可用性对于跨区域工作站的实在价值。\n        </p>\n      </div>\n      <div class=\"timeline-node\">\n        <p class=\"timeline-meta\">ROUTING LOGIC // 传输准则</p>\n        <div class=\"editorial-block\">\n          <h3>多中心拓扑与负载冗余</h3>\n          <p>\n            当数据包跨越海缆与公网交换节点，拥塞几乎是周期性必然。我们将流量划入不同等级的交换池中，透过主备倒换机制减少夜间高峰时段的抖动损耗。方案的配置核心不在于冗余的承诺，而在于对线路物理规律的坦诚尊重。\n          </p>\n        </div>\n      </div>\n    </div>\n\n    <section id=\"plans\">\n      <h2><span class=\"section-index\">01</span> 服务计划与资源配置</h2>\n      <div class=\"plan-list\">\n        <article class=\"plan-row\">\n          <div class=\"plan-header\">\n            <div class=\"plan-name-badge\">\n              <span class=\"plan-title\">基础版</span>\n            </div>\n            <div class=\"plan-pricing\">\n              <div class=\"plan-monthly\">¥15/月</div>\n              <div class=\"plan-annual\">按年付仅需 ¥150/年</div>\n            </div>\n          </div>\n          <ul class=\"plan-features\">\n            <li>每月 100GB 极速流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </article>\n\n        <article class=\"plan-row featured\">\n          <div class=\"plan-header\">\n            <div class=\"plan-name-badge\">\n              <span class=\"plan-title\">旗舰版</span>\n              <span class=\"plan-tag\">建议工作流</span>\n            </div>\n            <div class=\"plan-pricing\">\n              <div class=\"plan-monthly\">¥35/月</div>\n              <div class=\"plan-annual\">按年付仅需 ¥350/年</div>\n            </div>\n          </div>\n          <ul class=\"plan-features\">\n            <li>每月 300GB 极速流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7x24 优先工单支持</li>\n          </ul>\n        </article>\n\n        <article class=\"plan-row\">\n          <div class=\"plan-header\">\n            <div class=\"plan-name-badge\">\n              <span class=\"plan-title\">团队版</span>\n            </div>\n            <div class=\"plan-pricing\">\n              <div class=\"plan-monthly\">¥85/月</div>\n              <div class=\"plan-annual\">按年付仅需 ¥850/年</div>\n            </div>\n          </div>\n          <ul class=\"plan-features\">\n            <li>每月 1000GB 极速流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </article>\n      </div>\n    </section>\n\n    <section id=\"workflow\">\n      <h2><span class=\"section-index\">02</span> 接入指引与客户端配置</h2>\n      <div class=\"steps-container\">\n        <div class=\"step-card\">\n          <h3>第一步：选择符合工作负荷的规格</h3>\n          <p>\n            根据日常交互的数据吞吐量和在线设备密度评估方案。个人查阅文献或基础通信选用基础版即可满足，若有高精度交互、专线低延迟或多端并行需求，旗舰版与团队版提供更为宽裕的资源池。\n          </p>\n        </div>\n        <div class=\"step-card\">\n          <h3>第二步：获取标准化通用订阅文本</h3>\n          <p>\n            入网后系统生成专属的配置识别链接。该链接包含了当前接入点集合的端点地址、协议标识与验签公钥，支持以标准格式载入第三方网络管理工具。\n          </p>\n        </div>\n        <div class=\"step-card\">\n          <h3>第三步：适配各平台网络工具</h3>\n          <p>\n            我们并未捆绑专有封闭软件，用户可在 Windows、macOS、iOS、Android 以及 Linux 等系统上选用通用开源工具（如 Clash、Sing-box 或各类跨平台客户端），将订阅链接粘贴至配置源即可自动同步节点规则。\n          </p>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"faq\">\n      <h2><span class=\"section-index\">03</span> 常见问题与操作说明</h2>\n      <ul class=\"faq-numbered-list\">\n        <li class=\"faq-item\">\n          <div class=\"faq-question\">节点遭遇公网网络波动时如何自愈？</div>\n          <div class=\"faq-answer\">\n            系统具备动态探测机制，若上游出现不可抗抖动，核心路由将逐步切换流量至备份中继链路。用户侧建议在客户端内将分流模式设为规则或自动测试组，以便在毫秒级内完成自动漂移。\n          </div>\n        </li>\n        <li class=\"faq-item\">\n          <div class=\"faq-question\">支持的并发设备数是如何计算的？</div>\n          <div class=\"faq-answer\">\n            设备限制基于活跃会话的源标识进行计量。例如基础版允许 3 台设备在同一时间窗内保持长连接，超出限额的新设备将被排队或拒绝连接，断开后额度立即释放。\n          </div>\n        </li>\n        <li class=\"faq-item\">\n          <div class=\"faq-question\">不同操作系统之间是否有专属客户端下载？</div>\n          <div class=\"faq-answer\">\n            大阪國際遵循开放协议规范，不强制分发修改版私有程序。用户可依据所在系统自由挑选成熟的第三方开源代理内核，仅需导入订阅 URL 即可完成配置，保障了终端环境的纯净与透明。\n          </div>\n        </li>\n        <li class=\"faq-item\">\n          <div class=\"faq-question\">订阅周期的流量计费重置时间点为何时？</div>\n          <div class=\"faq-answer\">\n            流量周期通常自订单支付完成时刻起算，至次月同日自动归零重置。未用完的数据额度不跨月顺延，建议依实际工程需求合理规划使用周期。\n          </div>\n        </li>\n      </ul>\n    </section>\n  </main>\n\n  <nav class=\"bottom-nav\">\n    <div class=\"bottom-nav-inner\">\n      <div class=\"nav-brand\">大阪国際</div>\n      <div class=\"nav-links\">\n        <a href=\"#plans\">订阅方案</a>\n        <a href=\"#workflow\">配置指南</a>\n        <a href=\"#faq\">答疑记录</a>\n        <a href=\"#\">返回顶部</a>\n      </div>\n    </div>\n  </nav>",
